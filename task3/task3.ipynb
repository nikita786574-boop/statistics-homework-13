   "source": [
    "import numpy as np\n",
    "\n",
    "data = np.array([79, 74, 112, 95, 83, 96, 77, 84, 70, 90])\n",
    "\n",
    "s = np.std(data, ddof=1)\n",
    "n = len(data)\n",
    "\n",
    "t = 2.26\n",
    "\n",
    "delta = s / np.sqrt(n) * t\n",
    "print(round(delta, 4))"
   ]
